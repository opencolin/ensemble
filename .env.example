# Copy to .env (gitignored) and fill in.

# ── Nebius Token Factory: the models under test (live benchmark) ──
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=project-...
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# ── ConTree sandboxes (contree.dev): isolated test/agent execution ──
# Path A (token-factory, most common): set CONTREE_TOKEN + NEBIUS_PROJECT_ID above,
#   leave CONTREE_BASE_URL unset (defaults to the token-factory sandboxes endpoint).
# Path B (token-only JWT): set CONTREE_TOKEN + CONTREE_BASE_URL to your contree origin.
CONTREE_TOKEN=
# CONTREE_BASE_URL=
